          deleteBtn.classList.remove('text-on-surface-variant', 'bg-surface-container-low');
          deleteBtn.classList.add('text-error', 'bg-error-container', 'font-bold');
        } else {
          deleteBtn.classList.add('text-on-surface-variant', 'bg-surface-container-low');
          deleteBtn.classList.remove('text-error', 'bg-error-container', 'font-bold');
        }
      }
    }

    if (selectAll) {
      selectAll.addEventListener('change', function() {
        itemCheckboxes.forEach(cb => {
          cb.checked = selectAll.checked;
        });
        updateCount();
      });
    }

    itemCheckboxes.forEach(cb => {
      cb.addEventListener('change', updateCount);
    });
