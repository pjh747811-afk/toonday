      // Attach click listeners to edit buttons
      document.querySelectorAll('article button:first-child').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const article = e.target.closest('article');
          const speechBubble = article.querySelector('.text-sm');
          if (speechBubble) {
            currentBubbleTarget = speechBubble;
            modalTextarea.value = speechBubble.textContent.trim();
            editModal.classList.remove('hidden');
            editModal.classList.add('flex');
            modalTextarea.focus();
          }
        });
      });

      // Close modal functions
      function hideModal() {
        editModal.classList.add('hidden');
        editModal.classList.remove('flex');
      }

      closeModal.addEventListener('click', hideModal);
      cancelEdit.addEventListener('click', hideModal);
      editModal.addEventListener('click', (e) => {
        if (e.target === editModal) hideModal();
      });

      // Save Dialogue
      saveDialogue.addEventListener('click', () => {
        if (currentBubbleTarget && modalTextarea.value.trim()) {
          currentBubbleTarget.textContent = modalTextarea.value.trim();
          
          // Little bounce animation
          const parentBox = currentBubbleTarget.closest('.relative');
          parentBox.classList.add('scale-105', 'bg-secondary-container');
          setTimeout(() => {
            parentBox.classList.remove('scale-105', 'bg-secondary-container');
          }, 300);
        }
        hideModal();
      });

      // Native Web Share or Toast feedback
      const shareBtn = document.getElementById('btn-share-top');
      const instaBtn = document.getElementById('btn-insta');
      const kakaoBtn = document.getElementById('btn-kakao');
      const downloadBtn = document.getElementById('btn-save-device');

      function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-inverse-surface text-inverse-on-surface px-4 py-2 rounded-full text-xs font-medium shadow-xl flex items-center gap-1.5 animate-bounce';
        toast.innerHTML = `<span class="material-symbols-outlined text-[16px] text-tertiary-fixed">info</span> \${message}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2500);
      }

      if (shareBtn) {
        shareBtn.addEventListener('click', () => {
          if (navigator.share) {
