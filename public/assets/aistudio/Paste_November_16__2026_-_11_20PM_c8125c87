  function openEpisodeViewer(epNum) {
    currentViewerEpisode = epNum;
    const modal = document.getElementById('webtoonViewerModal');
    renderEpisodeContent(epNum);
    modal.style.display = 'flex';
    requestAnimationFrame(() => {
      modal.classList.remove('translate-y-full');
    });
    if (isAutoPlayEnabled) {
      startAutoNextCountdown();
    }
  }

  function closeEpisodeViewer() {
    stopAutoNextCountdown();
    const modal = document.getElementById('webtoonViewerModal');
    modal.classList.add('translate-y-full');
    setTimeout(() => {
      modal.style.display = 'none';
    }, 300);
  }

  function renderEpisodeContent(epNum) {
    const data = episodeData[epNum] || episodeData[18];
    document.getElementById('viewerEpisodeTitle').textContent = data.title;
    document.getElementById('viewerLikeCount').textContent = data.likes;

    const cutsContainer = document.getElementById('viewerCutsBody');
    cutsContainer.innerHTML = data.cuts.map((cut, idx) => `
      <div class="flex flex-col gap-2 rounded-2xl overflow-hidden bg-surface-container-low p-3 shadow-xs border border-surface-container">
        <div class="w-full aspect-[4/3] rounded-xl overflow-hidden bg-surface-container">
          <img class="w-full h-full object-cover" src="${cut.img}" alt="${cut.desc}">
        </div>
        <p class="text-xs text-on-surface-variant font-medium px-1">${cut.desc}</p>
      </div>
    `).join('');

    const nextBtnLabel = document.getElementById('viewerNextBtnLabel');
    const countdownCard = document.getElementById('autoNextCountdownCard');
    if (data.nextEp) {
      if (nextBtnLabel) nextBtnLabel.textContent = `다음화 (${data.nextEp}화)`;
      if (countdownCard) {
        countdownCard.style.display = 'flex';
        document.getElementById('countdownNoticeText').textContent = `3초 후 다음 에피소드(${data.nextTitle})로 자동 이동`;
      }
    } else {
      if (nextBtnLabel) nextBtnLabel.textContent = '마지막화';
      if (countdownCard) countdownCard.style.display = 'none';
    }
  }

  function startAutoNextCountdown() {
    stopAutoNextCountdown();
    if (!isAutoPlayEnabled || isAutoPaused || !episodeData[currentViewerEpisode]?.nextEp) return;

    countdownSeconds = 3;
    currentProgressPercent = 0;
    const progressBar = document.getElementById('autoNextProgressBar');
    const badge = document.getElementById('countdownBadge');
    if (progressBar) progressBar.style.width = '0%';
    if (badge) badge.textContent = '3초';

    const stepTime = 50;
    const totalTime = 3000;
    const progressIncrement = (stepTime / totalTime) * 100;

    autoProgressInterval = setInterval(() => {
      if (isAutoPaused) return;
      currentProgressPercent += progressIncrement;
      if (progressBar) progressBar.style.width = Math.min(currentProgressPercent, 100) + '%';
      const remaining = Math.max(0, Math.ceil((100 - currentProgressPercent) / 33.3));
      if (badge) badge.textContent = remaining + '초';

      if (currentProgressPercent >= 100) {
        stopAutoNextCountdown();
        triggerImmediateNext();
      }
    }, stepTime);
  }

  function stopAutoNextCountdown() {
    if (autoProgressInterval) {
      clearInterval(autoProgressInterval);
      autoProgressInterval = null;
    }
  }

  function toggleAutoNext() {
    isAutoPlayEnabled = !isAutoPlayEnabled;
    const btn = document.getElementById('autoPlayToggleBtn');
    const label = document.getElementById('autoPlayLabel');
    const icon = document.getElementById('autoPlayIcon');
    if (isAutoPlayEnabled) {
      btn.classList.add('bg-secondary-container', 'text-on-secondary-container');
      btn.classList.remove('bg-surface-container-high', 'text-outline');
      label.textContent = '자동 넘김 ON';
      icon.textContent = 'play_circle';
      showToast('자동 연속 감상 모드가 켜졌습니다 ⚡');
      isAutoPaused = false;
      startAutoNextCountdown();
    } else {
      btn.classList.remove('bg-secondary-container', 'text-on-secondary-container');
      btn.classList.add('bg-surface-container-high', 'text-outline');
      label.textContent = '자동 넘김 OFF';
      icon.textContent = 'pause_circle';
      stopAutoNextCountdown();
      showToast('자동 연속 감상 모드가 꺼졌습니다 ⏸️');
    }
  }

  function toggleAutoNextPause() {
    isAutoPaused = !isAutoPaused;
    const pauseLabel = document.getElementById('pauseBtnLabel');
    const pauseIcon = document.getElementById('pauseIconState');
    if (isAutoPaused) {
      pauseLabel.textContent = '자동 넘김 재개';
      pauseIcon.textContent = 'play_arrow';
      showToast('자동 넘김이 일시정지되었습니다 ⏸️');
    } else {
      pauseLabel.textContent = '자동 넘김 일시정지';
      pauseIcon.textContent = 'pause_circle';
      showToast('자동 넘김이 다시 시작됩니다 ⚡');
    }
  }

  function triggerImmediateNext() {
    stopAutoNextCountdown();
    const nextEp = episodeData[currentViewerEpisode]?.nextEp;
    if (!nextEp) {
      showToast('모든 에피소드를 정주행 완료했습니다! 🎉');
      return;
    }
    currentViewerEpisode = nextEp;
    renderEpisodeContent(nextEp);
    const scrollContainer = document.getElementById('viewerScrollContainer');
    if (scrollContainer) scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
    showToast(nextEp + '화로 자동 전환되었습니다! 📖');
  }

  function switchViewerEpisode() {
    triggerImmediateNext();
  }

  function toggleViewerLike() {
