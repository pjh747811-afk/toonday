<script>
  (function initLoadingExperience() {
    let seconds = 9;
    const timerEl = document.getElementById('elapsed-timer');
    const percentEl = document.getElementById('percent-display');
    const progressFill = document.getElementById('progress-bar-fill');
    const notifyBtn = document.getElementById('bg-notify-btn');

    // Timer simulation
    const timerInterval = setInterval(() => {
      seconds++;
      const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
      const secs = String(seconds % 60).padStart(2, '0');
      if (timerEl) timerEl.textContent = `${mins}:${secs}`;
    }, 1000);

    // Realistic progress percentage ticker
    let currentPercent = 68;
    const progressInterval = setInterval(() => {
      if (currentPercent < 94) {
        currentPercent += Math.floor(Math.random() * 3) + 1;
        if (currentPercent > 94) currentPercent = 94;
        if (percentEl) percentEl.textContent = currentPercent;
        if (progressFill) progressFill.style.width = currentPercent + '%';
      }
    }, 1200);

    if (notifyBtn) {
      notifyBtn.addEventListener('click', () => {
        notifyBtn.innerHTML = `
          <span class="material-symbols-outlined text-tertiary text-[20px]">check_circle</span>
          <span class="text-tertiary font-bold">완료 시 푸시 알림이 예약되었어요!</span>
