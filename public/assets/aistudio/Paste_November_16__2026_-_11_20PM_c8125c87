<script>
  let isLiked = false;
  let likeCount = 142;
  let commentsCount = 12;

  function toggleLikeCollection() {
    const countEl = document.getElementById('likeCollectionCount');
    const heartIcon = document.getElementById('likeHeartIcon');
    const btn = document.getElementById('likeCollectionBtn');

    isLiked = !isLiked;
    if (isLiked) {
      likeCount++;
      heartIcon.style.fontVariationSettings = "'FILL' 1";
      btn.classList.add('bg-primary-fixed');
      showToast('이 컬렉션을 좋아합니다! ❤️');
    } else {
      likeCount--;
      heartIcon.style.fontVariationSettings = "'FILL' 0";
      btn.classList.remove('bg-primary-fixed');
    }
    countEl.textContent = likeCount;
  }

  function copyShareLink() {
    const copyTextState = document.getElementById('copyTextState');
    navigator.clipboard?.writeText(window.location.href).catch(() => {});
    copyTextState.textContent = '복사 완료!';
    showToast('공유 링크가 클립보드에 복사되었습니다 🔗');
    setTimeout(() => {
      copyTextState.textContent = '링크 복사';
    }, 2000);
  }

  function shareKakao() {
    showToast('카카오톡 공유 창을 호출했습니다 💬');
  }

  function readEpisode(epNum) {
    showToast(epNum + '화 에피소드 뷰어로 이동합니다 📖');
  }

  function triggerWebtoonCreation() {
    showToast('✨ AI 4컷 웹툰 생성 스튜디오로 이동합니다!');
  }

  function triggerAppInstall() {
    showToast('📲 ToonDay 앱 마켓 또는 앱 실행 딥링크로 연결합니다.');
  }

  function handleCommentKey(e) {
    if (e.key === 'Enter') {
      submitGuestComment();
    }
  }

  function submitGuestComment() {
    const input = document.getElementById('guestCommentInput');
    const text = input.value.trim();
    if (!text) {
      showToast('한 줄 소감을 작성해주세요!');
      return;
    }

    const container = document.getElementById('commentListContainer');
    const newComment = document.createElement('div');
    newComment.className = 'bg-surface-container-lowest rounded-full p-3 shadow-xs flex items-start gap-2.5 transition-all transform animate-pulse';
    newComment.innerHTML = `
      <div class="w-7 h-7 rounded-full bg-secondary-container flex items-center justify-center text-xs font-bold text-secondary flex-shrink-0">
        나
      </div>
      <div class="flex flex-col flex-1 min-w-0">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-on-surface truncate">방문 독자</span>
          <span class="text-[10px] text-outline font-medium">방금 전</span>
        </div>
        <p class="text-xs text-on-surface-variant mt-0.5">${escapeHtml(text)}</p>
      </div>
    `;

    container.insertBefore(newComment, container.firstChild);
    setTimeout(() => newComment.classList.remove('animate-pulse'), 800);
    input.value = '';

    commentsCount++;
    document.getElementById('commentCountBadge').textContent = '(' + commentsCount + ')';
    showToast('소중한 감상평이 등록되었어요! ✨');
  }

  function showToast(msg) {
    const prev = document.getElementById('toonToast');
    if (prev) prev.remove();

    const toast = document.createElement('div');
    toast.id = 'toonToast';
    toast.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full bg-inverse-surface text-inverse-on-surface text-xs font-semibold shadow-lg transition-all duration-300 pointer-events-none opacity-0';
    toast.textContent = msg;
    document.body.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');
    });

    setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0');
      setTimeout(() => toast.remove(), 300);
    }, 2200);
  }

  function escapeHtml(string) {
    return String(string).replace(/[&<>"'`=\/]/g, function (s) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
        '/': '&#x2F;',
        '`': '&#x60;',
        '=': '&#x3D;'
      }[s];
    });
  }
</script></main>

